# ===============================
# Telegram Bot Configuration
# ===============================
# Dapatkan dari @BotFather di Telegram
BOT_TOKEN=bot-token

# ===============================
# Telegram Client API (untuk OTP resmi via Telethon)
# ===============================
# Dapatkan dari https://my.telegram.org → API Development Tools
API_ID=app-id
API_HASH=a[i-hasg]

# ===============================
# Redis Configuration
# ===============================
# Format: redis://[:password@]host:port/db
# Di Heroku, gunakan REDIS_URL yang diset oleh add-on Heroku Data for Redis
REDIS_URL=redis://localhost:6379/0

# ===============================
# Webhook Configuration (Heroku)
# ===============================
# URL publik aplikasi Heroku (tanpa trailing slash)
# Contoh: https://nama-app-anda.herokuapp.com
WEBHOOK_URL=https://your-app-name.herokuapp.com

# Port yang disediakan Heroku (otomatis diset oleh Heroku)
# Set secara manual hanya untuk lokal
PORT=8443

# Path webhook (endpoint yang dipanggil Telegram)
WEBHOOK_PATH=/webhook

# ===============================
# OTP Configuration
# ===============================
# Masa berlaku OTP dalam detik (180 = 3 menit)
OTP_EXPIRY_SECONDS=180

# Cooldown kirim ulang dalam detik (180 = 3 menit)
OTP_RESEND_COOLDOWN=180

# Maksimal percobaan verifikasi OTP
OTP_MAX_ATTEMPTS=3

# ===============================
# Rate Limiting
# ===============================
# Maksimal request OTP baru per window
RATE_LIMIT_MAX_REQUESTS=3

# Window rate limit dalam detik (600 = 10 menit)
RATE_LIMIT_WINDOW=600
